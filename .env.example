# Local demo only. Generate a separate random key before running.
APP_ALLOW_LOCAL_LOGIN=true
APP_ACCESS_TOKEN_SIGNING_KEY=
APP_ACCESS_TOKEN_ISSUER=app-authorization-demo
APP_ACCESS_TOKEN_AUDIENCE=app-authorization-demo
APP_ACCESS_TOKEN_TTL_SECONDS=43200
APP_ACCESS_TOKEN_MAX_TTL_SECONDS=2592000
# Shared SSO configuration
SSO_ID_TOKEN_HEADER=X-Forwarded-Id-Token
# SSO_GOOGLE_CLIENT_ID の正本は SSO 基盤（リバースプロキシ）側。
# プロキシは CLIENT_ID / SECRET で Google にログインし、発行された ID トークンを
# X-Forwarded-Id-Token で転送する。トークンの aud にはその CLIENT_ID が入る。
# アプリはプロキシと同じ CLIENT_ID を設定し、aud の一致を検証する。SECRET は渡さない。
# プロキシが Google ログインで得た ID トークン（aud = CLIENT_ID）を X-Forwarded-Id-Token で転送する。
# アプリは同じ CLIENT_ID を SSO_GOOGLE_CLIENT_ID に持ち、aud の一致を検証する。
SSO_GOOGLE_CLIENT_ID=
SSO_LOGOUT_URL=
